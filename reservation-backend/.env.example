# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/hotel_reservation_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Security & JWT
JWT_SECRET_KEY=generate_a_random_base64_secret_key_minimum_256_bits
JWT_EXPIRATION=86400000

# Initial Admin Credentials (Optional override)
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_EMAIL=superadmin@hotel.com
SECURITY_ADMIN_PASSWORD=admin123
